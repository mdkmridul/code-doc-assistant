# Build context for apps/api/Dockerfile and apps/web/Dockerfile (both use the repo root).
# Dependencies and build output are produced inside the image, never copied from the host.
**/node_modules
**/dist
**/.next
**/*.tsbuildinfo
**/coverage
**/*.log
apps/api/src/generated

# Secrets stay out of images: the API reads them from compose at run time.
.env
.env.*
!.env.example

.git
docs
