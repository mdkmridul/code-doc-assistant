# Dependencies (any depth)
node_modules/
.pnp
.pnp.*

# Only the root lockfile is used in an npm workspace
apps/*/package-lock.json
packages/*/package-lock.json

# Build output
dist/
build/
out/
.next/
*.tsbuildinfo

# Testing
coverage/
.nyc_output/

# Env files (keep an example committed)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/

# Caches
.turbo/
.cache/
.eslintcache
.vercel/

# Editor / OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
*.pem

# Prisma client, regenerated by `npm install` (postinstall) or `npm run prisma:generate -w api`
apps/api/src/generated/
