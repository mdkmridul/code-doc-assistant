{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": ".*\\.int-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/test/int-global-setup.ts",
  "moduleNameMapper": {
    "^@cda/domain$": "<rootDir>/../../packages/domain/src"
  },
  "testTimeout": 60000
}
