# Copy to `.env` at the repo root and fill in every value.
# `.env` is read by docker compose and by the API (apps/api/src/config/env.schema.ts).
# Keep this file in sync: every variable the project reads must be listed here.

# ---------------------------------------------------------------------------
# Docker Compose: local Postgres (pgvector) and Redis
# ---------------------------------------------------------------------------
POSTGRES_USER=cda
POSTGRES_PASSWORD=cda
POSTGRES_DB=cda
# Host ports. Change them if something else already listens there.
POSTGRES_PORT=5432
REDIS_PORT=6379
# Host port of the local Ollama embedding server.
OLLAMA_PORT=11434
# Optional, read by docker compose: run Ollama on an NVIDIA GPU (~23x faster
# ingestion). Uncomment both lines on machines with GPU support.
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=docker-compose.yml,docker-compose.gpu.yml

# ---------------------------------------------------------------------------
# API (apps/api). Validated at startup; the API refuses to boot if any is missing.
# ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
API_PORT=3001
# Read by the API and by the Prisma CLI (apps/api/prisma.config.ts).
# Must match the POSTGRES_* values and POSTGRES_PORT above.
DATABASE_URL=postgresql://cda:cda@localhost:5432/cda
# Must match REDIS_PORT above.
REDIS_URL=redis://localhost:6379
# Ollama server that embeds code chunks with nomic-embed-text (ADR 0009). Read by the API.
# Must match OLLAMA_PORT above.
OLLAMA_URL=http://localhost:11434
# Claude answers questions (ADR 0011). Read by the API. Create a key at
# https://platform.claude.com/ (API keys).
ANTHROPIC_API_KEY=
# Model id; its price must be in apps/api/src/infrastructure/llm/anthropic-pricing.ts.
ANTHROPIC_MODEL=claude-opus-5-5
# Agent loop limits per question: model calls (the last one answers without tools)
# and total input+output tokens across those calls. Read by the API.
CHAT_MAX_ITERATIONS=8
CHAT_TOKEN_BUDGET=200000
