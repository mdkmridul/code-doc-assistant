# Copy to `.env` at the repo root and fill in every value.
# `.env` is read by docker compose and by the API (apps/api/src/config/env.schema.ts).
# URLs below are for running the API on the host. With `docker compose --profile app`
# the API container gets every value from here through env_file, except
# DATABASE_URL, REDIS_URL and OLLAMA_URL, which compose points at its services.
# Keep this file in sync: every variable the project reads must be listed here.

# ---------------------------------------------------------------------------
# Docker Compose: local Postgres (pgvector) and Redis
# ---------------------------------------------------------------------------
POSTGRES_USER=cda
POSTGRES_PASSWORD=cda
POSTGRES_DB=cda
# Host ports. Change them if something else already listens there.
POSTGRES_PORT=5432
REDIS_PORT=6379
# Host port of the local Ollama embedding server.
OLLAMA_PORT=11434
# Optional, read by docker compose: run Ollama on an NVIDIA GPU (~23x faster
# ingestion). Uncomment both lines on machines with GPU support.
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=docker-compose.yml,docker-compose.gpu.yml

# ---------------------------------------------------------------------------
# API (apps/api). Validated at startup; the API refuses to boot if any is missing.
# ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
API_PORT=3001
# Read by the API and by the Prisma CLI (apps/api/prisma.config.ts).
# Must match the POSTGRES_* values and POSTGRES_PORT above.
DATABASE_URL=postgresql://cda:cda@localhost:5432/cda
# Must match REDIS_PORT above.
REDIS_URL=redis://localhost:6379
# Ollama server that embeds code chunks with nomic-embed-text (ADR 0009). Read by the API.
# Must match OLLAMA_PORT above.
OLLAMA_URL=http://localhost:11434
# Claude answers questions (ADR 0011). Read by the API. Create a key at
# https://platform.claude.com/ (API keys).
ANTHROPIC_API_KEY=
# Model id; its price must be in apps/api/src/infrastructure/llm/anthropic-pricing.ts.
ANTHROPIC_MODEL=claude-opus-5-5
# Agent loop limits per question: model calls (the last one answers without tools)
# and total input+output tokens across those calls. Read by the API.
CHAT_MAX_ITERATIONS=8
CHAT_TOKEN_BUDGET=200000
# Most estimated tokens all tool results of one question may add to the context
# (ADR 0016). A result that would go over is refused and the model answers with
# what it has. Read by the API.
CHAT_CONTEXT_BUDGET=40000
# Usage limits kept in Redis (ADR 0020). Read by the API. Questions one chat session may
# ask per minute (more get HTTP 429 with a readable message).
SESSION_QUESTIONS_PER_MINUTE=6
# Most USD of model calls per UTC day, across all sessions. Once reached, questions are
# refused with a readable message until midnight UTC (one call may overshoot it).
DAILY_SPEND_CAP_USD=25
# Browser origin of the web app, allowed by the API's CORS policy. Read by the API.
# The web container is published on port 3000, so keep it at :3000 for compose.
WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Web (apps/web). Loaded by apps/web/next.config.ts and inlined into the browser
# bundle at build/dev time, so it must not hold secrets.
# ---------------------------------------------------------------------------
# Where the browser reaches the API. Must match API_PORT above. Also a build
# argument of the web image (docker compose --profile app): rebuild it after a change.
NEXT_PUBLIC_API_URL=http://localhost:3001
