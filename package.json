{
  "name": "code-doc-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Code Documentation Assistant",
  "license": "ISC",
  "author": "Mridul Hemani",
  "type": "commonjs",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:integration": "npm run test:int --workspaces --if-present"
  }
}
